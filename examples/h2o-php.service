[Unit]
Description=H2O with embedded ZTS PHP
After=network.target

[Service]
Type=simple
Environment=H2O_ROOT=/usr/local
RuntimeDirectory=h2o-php
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/h2o-php run --config /etc/h2o-php/h2o.conf --address unix//run/h2o-php/control.sock
ExecReload=/usr/local/bin/h2o-php reload --config /etc/h2o-php/h2o.conf --address unix//run/h2o-php/control.sock
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=35
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
