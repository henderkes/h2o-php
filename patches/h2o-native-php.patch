new file mode 100644
index 000000000..0b6dc1bea
--- /dev/null
+++ b/lib/http1/body-lease.c.h
@@ -0,0 +1,553 @@
+/* Private synchronous plain-H1 writer. This file also builds in the focused C
+ * harness; its worker half deliberately has no access to H2O object storage. */
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#ifdef __linux__
+#include <sys/eventfd.h>
+#include <sched.h>
+#include <fcntl.h>
+#endif
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef H2O_BODY_LEASE_SENDMSG
+#define H2O_BODY_LEASE_SENDMSG sendmsg
+#endif
+#ifndef H2O_BODY_LEASE_POLL
+#define H2O_BODY_LEASE_POLL poll
+#endif
+
+/* Process-local kernel-copy admission, independent of PHP execution. Startup
+ * discovers the inherited allowed physical cores before any loop is pinned.
+ * Missing topology leaves the original unrestricted transport path intact. */
+struct body_send_waiter {
+    struct body_send_waiter *prev, *next;
+    pthread_cond_t *ready;
+};
+static struct {
+    pthread_mutex_t mutex;
+    pthread_condattr_t condattr;
+    struct body_send_waiter *head, *tail;
+    size_t waiting;
+    unsigned active, limit, physical;
+    int enabled, pressured;
+} body_send_gate = {.mutex = PTHREAD_MUTEX_INITIALIZER};
+static pthread_once_t body_send_once = PTHREAD_ONCE_INIT;
+
+#if defined(__linux__) && !H2O_USE_LIBUV
+struct body_core_id { int package, core; };
+static int body_core_compare(const void *a, const void *b)
+{
+    const struct body_core_id *x = a, *y = b;
+    if (x->package != y->package)
+        return x->package < y->package ? -1 : 1;
+    return x->core < y->core ? -1 : x->core != y->core;
+}
+
+static int body_core_read(unsigned cpu, const char *name, int *value)
+{
+    char path[128], text[64];
+    int n = snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/topology/%s", cpu, name);
+    if (n < 0 || (size_t)n >= sizeof(path))
+        return -1;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return -1;
+    ssize_t got;
+    do { got = read(fd, text, sizeof(text) - 1); } while (got < 0 && errno == EINTR);
+    close(fd);
+    if (got <= 0 || got == sizeof(text) - 1)
+        return -1;
+    text[got] = 0;
+    char *end;
+    errno = 0;
+    long parsed = strtol(text, &end, 10);
+    if (errno != 0 || end == text || parsed < 0 || parsed > INT_MAX ||
+        (*end != 0 && !(*end == '\n' && end[1] == 0)))
+        return -1;
+    *value = (int)parsed;
+    return 0;
+}
+
+static unsigned body_allowed_physical_cores(void)
+{
+#if defined(CPU_ALLOC) && defined(CPU_ALLOC_SIZE) && defined(CPU_FREE) && defined(CPU_ZERO_S) && defined(CPU_COUNT_S)
+    /* Dynamic affinity masks also cover hosts with CPU indices > CPU_SETSIZE.
+     * The Linux affinity ABI supports at most 65536 bits in this discovery. */
+    size_t bits = CPU_SETSIZE;
+    const size_t max_bits = 65536;
+    if (bits == 0 || bits > max_bits)
+        return 0;
+    cpu_set_t *mask;
+    size_t bytes;
+    for (;;) {
+        bytes = CPU_ALLOC_SIZE(bits);
+        mask = CPU_ALLOC(bits);
+        if (mask == NULL)
+            return 0;
+        CPU_ZERO_S(bytes, mask);
+        if (sched_getaffinity(0, bytes, mask) == 0)
+            break;
+        int error = errno;
+        CPU_FREE(mask);
+        if (error != EINVAL || bits == max_bits)
+            return 0;
+        bits = bits > max_bits / 2 ? max_bits : bits * 2;
+    }
+    int count = CPU_COUNT_S(bytes, mask);
+    struct body_core_id *cores = count > 0 ? calloc((size_t)count, sizeof(*cores)) : NULL;
+    unsigned used = 0, physical = 0;
+    if (cores != NULL) {
+        for (size_t cpu = 0; cpu != bits; ++cpu) {
+            if (!CPU_ISSET_S(cpu, bytes, mask))
+                continue;
+            if (body_core_read((unsigned)cpu, "physical_package_id", &cores[used].package) != 0 ||
+                body_core_read((unsigned)cpu, "core_id", &cores[used].core) != 0)
+                goto Exit;
+            ++used;
+        }
+        qsort(cores, used, sizeof(*cores), body_core_compare);
+        for (unsigned i = 0; i != used; ++i)
+            if (i == 0 || body_core_compare(cores + i - 1, cores + i) != 0)
+                ++physical;
+    }
+Exit:
+    free(cores);
+    CPU_FREE(mask);
+    return used == (unsigned)count ? physical : 0;
+#else
+    return 0;
+#endif
+}
+
+static void body_send_fork_prepare(void) { pthread_mutex_lock(&body_send_gate.mutex); }
+static void body_send_fork_parent(void) { pthread_mutex_unlock(&body_send_gate.mutex); }
+static void body_send_fork_child(void)
+{
+    /* No waiter thread survives. Never retain a permit or a stack waiter from
+     * the parent's host graph; child transport is disabled by the host too. */
+    body_send_gate.enabled = 0;
+    body_send_gate.active = 0;
+    body_send_gate.waiting = 0;
+    body_send_gate.pressured = 0;
+    body_send_gate.head = body_send_gate.tail = NULL;
+    pthread_mutex_unlock(&body_send_gate.mutex);
+}
+#endif
+
+static void body_send_init(void)
+{
+#if defined(__linux__) && !H2O_USE_LIBUV
+    unsigned physical = body_allowed_physical_cores();
+    if (physical == 0 || pthread_condattr_init(&body_send_gate.condattr) != 0)
+        return;
+    if (pthread_condattr_setclock(&body_send_gate.condattr, CLOCK_MONOTONIC) != 0) {
+        pthread_condattr_destroy(&body_send_gate.condattr);
+        return;
+    }
+    if (pthread_atfork(body_send_fork_prepare, body_send_fork_parent, body_send_fork_child) != 0) {
+        pthread_condattr_destroy(&body_send_gate.condattr);
+        return;
+    }
+    /* Oversubscribed copy demand leaves one physical core of headroom. A
+     * single-core host still needs one slot to make transport progress. */
+    body_send_gate.limit = physical > 1 ? physical - 1 : 1;
+    body_send_gate.physical = physical;
+    body_send_gate.enabled = 1;
+#endif
+}
+
+void h2o_http1_body_lease_startup(void)
+{
+    (void)pthread_once(&body_send_once, body_send_init);
+}
+
+enum { BODY_LEASE_IDLE, BODY_LEASE_WRITING, BODY_LEASE_RETURNING, BODY_LEASE_REVOKING, BODY_LEASE_RETURNED };
+struct st_h2o_http1_body_lease_t {
+    atomic_uint refs, state;
+    atomic_int error;
+    atomic_uint_fast64_t last_progress_ns, payload_submitted, wire_submitted;
+    int fd, cancel_fd, chunked;
+    uint64_t io_timeout_ns;
+    pthread_t loop_thread, writer_thread;
+    int writer_set;
+    pthread_cond_t send_ready;
+    int send_ready_initialized;
+    void (*notify)(void *);
+    void *notify_data;
+    /* Owning-loop fields. The worker never reads or writes these. */
+    struct st_h2o_http1_conn_t *conn;
+    int close_requested, close_socket;
+};
+
+static uint64_t body_lease_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+static uint64_t body_lease_add_ns(uint64_t a, uint64_t b)
+{
+    return UINT64_MAX - a < b ? UINT64_MAX : a + b;
+}
+
+size_t h2o_http1_body_lease_charge(void)
+{
+    return sizeof(h2o_http1_body_lease_t);
+}
+
+void h2o_http1_body_lease_release(h2o_http1_body_lease_t *lease)
+{
+    if (atomic_fetch_sub_explicit(&lease->refs, 1, memory_order_acq_rel) != 1)
+        return;
+    assert(atomic_load_explicit(&lease->state, memory_order_acquire) == BODY_LEASE_RETURNED);
+    if (lease->send_ready_initialized)
+        pthread_cond_destroy(&lease->send_ready);
+    H2O_HOST_FD_CLOSE(lease->cancel_fd);
+    free(lease);
+}
+
+static h2o_http1_body_lease_t *body_lease_new(int fd, int chunked, uint64_t io_timeout_ms,
+                                           void (*notify)(void *), void *data)
+{
+#if defined(__linux__) && !H2O_USE_LIBUV
+    h2o_http1_body_lease_t *lease = calloc(1, sizeof(*lease));
+    if (lease == NULL)
+        return NULL;
+    if (body_send_gate.enabled) {
+        if (pthread_cond_init(&lease->send_ready, &body_send_gate.condattr) != 0) {
+            free(lease);
+            return NULL;
+        }
+        lease->send_ready_initialized = 1;
+    }
+    H2O_HOST_FDS_BEGIN();
+    lease->cancel_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    if (lease->cancel_fd >= 0)
+        H2O_HOST_FD_REGISTER(lease->cancel_fd);
+    H2O_HOST_FDS_END();
+    if (lease->cancel_fd < 0) {
+        if (lease->send_ready_initialized)
+            pthread_cond_destroy(&lease->send_ready);
+        free(lease);
+        return NULL;
+    }
+    atomic_init(&lease->refs, 2); /* H1 and the external caller. */
+    atomic_init(&lease->state, BODY_LEASE_IDLE);
+    atomic_init(&lease->error, 0);
+    atomic_init(&lease->last_progress_ns, body_lease_now());
+    atomic_init(&lease->payload_submitted, 0);
+    atomic_init(&lease->wire_submitted, 0);
+    lease->fd = fd;
+    lease->chunked = chunked;
+    lease->io_timeout_ns = io_timeout_ms > UINT64_MAX / 1000000 ? UINT64_MAX : io_timeout_ms * 1000000;
+    lease->loop_thread = pthread_self();
+    lease->notify = notify;
+    lease->notify_data = data;
+    return lease;
+#else
+    return NULL;
+#endif
+}
+
+/* The immutable lease and WRITING/RETURNING pin are the call generation:
+ * tokens are never recycled, and no other call can enter until writer_exit.
+ * Gate waiters retain that pin and the writer reference, without R/B locks. */
+static int body_send_terminal(h2o_http1_body_lease_t *lease, uint64_t deadline_ns)
+{
+    unsigned state = atomic_load_explicit(&lease->state, memory_order_acquire);
+    int error = atomic_load_explicit(&lease->error, memory_order_acquire);
+    if (error != 0)
+        return error;
+    if (state != BODY_LEASE_WRITING && state != BODY_LEASE_RETURNING)
+        return ECANCELED;
+    return body_lease_now() >= deadline_ns ? ETIMEDOUT : 0;
+}
+
+/* Demand consists only of actual send attempts: active sends, FIFO waiters,
+ * and an arriving attempt not yet queued. Demand that fits physical cores can
+ * progress independently until oversubscription retains the original one-core
+ * headroom for this entire busy period. Only no active sends and no waiters
+ * restore the higher capacity. Previously admitted sends drain on a pressure
+ * increase; the hard bound is always physical cores. All fields and decisions
+ * here use the gate mutex. */
+static unsigned body_send_capacity(unsigned arriving)
+{
+    assert(body_send_gate.active <= body_send_gate.physical);
+    if (body_send_gate.active == 0 && body_send_gate.waiting == 0)
+        body_send_gate.pressured = 0;
+    size_t available = body_send_gate.physical - body_send_gate.active;
+    if (arriving > available || body_send_gate.waiting > available - arriving)
+        body_send_gate.pressured = 1;
+    return body_send_gate.pressured ? body_send_gate.limit : body_send_gate.physical;
+}
+
+static void body_send_signal_head(void)
+{
+    unsigned capacity = body_send_capacity(0);
+    if (body_send_gate.head != NULL && body_send_gate.active < capacity)
+        pthread_cond_signal(body_send_gate.head->ready);
+}
+
+static int body_send_enter(h2o_http1_body_lease_t *lease, uint64_t deadline_ns)
+{
+    if (!body_send_gate.enabled)
+        return 0;
+    struct body_send_waiter waiter = {.ready = &lease->send_ready};
+    pthread_mutex_lock(&body_send_gate.mutex);
+    unsigned capacity = body_send_capacity(1);
+    int queued = body_send_gate.head != NULL || body_send_gate.active >= capacity;
+    if (queued) {
+        waiter.prev = body_send_gate.tail;
+        if (waiter.prev != NULL)
+            waiter.prev->next = &waiter;
+        else
+            body_send_gate.head = &waiter;
+        body_send_gate.tail = &waiter;
+        ++body_send_gate.waiting;
+    }
+    int error;
+    for (;;) {
+        if ((error = body_send_terminal(lease, deadline_ns)) != 0)
+            break;
+        if ((!queued || body_send_gate.head == &waiter) && body_send_gate.active < body_send_capacity(!queued))
+            break;
+        struct timespec until = {.tv_sec = deadline_ns / 1000000000, .tv_nsec = deadline_ns % 1000000000};
+        int ret = pthread_cond_timedwait(&lease->send_ready, &body_send_gate.mutex, &until);
+        if (ret != 0 && ret != ETIMEDOUT) {
+            error = ret;
+            break;
+        }
+    }
+    if (queued) {
+        if (waiter.prev != NULL)
+            waiter.prev->next = waiter.next;
+        else
+            body_send_gate.head = waiter.next;
+        if (waiter.next != NULL)
+            waiter.next->prev = waiter.prev;
+        else
+            body_send_gate.tail = waiter.prev;
+        assert(body_send_gate.waiting != 0);
+        --body_send_gate.waiting;
+    }
+    if (error == 0)
+        ++body_send_gate.active;
+    body_send_signal_head();
+    pthread_mutex_unlock(&body_send_gate.mutex);
+    return error;
+}
+
+static void body_send_leave(void)
+{
+    if (!body_send_gate.enabled)
+        return;
+    pthread_mutex_lock(&body_send_gate.mutex);
+    assert(body_send_gate.active != 0);
+    --body_send_gate.active;
+    body_send_signal_head();
+    pthread_mutex_unlock(&body_send_gate.mutex);
+}
+
+static void body_send_cancel(h2o_http1_body_lease_t *lease)
+{
+    if (!body_send_gate.enabled)
+        return;
+    /* Publish terminal state before this lock; the waiter checks under it
+     * before cond_wait, so revocation cannot miss the enqueue-to-wait edge. */
+    pthread_mutex_lock(&body_send_gate.mutex);
+    pthread_cond_signal(&lease->send_ready);
+    pthread_mutex_unlock(&body_send_gate.mutex);
+}
+
+static void body_lease_set_error(h2o_http1_body_lease_t *lease, int error)
+{
+    int expected = 0;
+    atomic_compare_exchange_strong_explicit(&lease->error, &expected, error, memory_order_release, memory_order_relaxed);
+}
+
+static void body_lease_wake(h2o_http1_body_lease_t *lease)
+{
+    uint64_t one = 1;
+    ssize_t ret;
+    do {
+        ret = write(lease->cancel_fd, &one, sizeof(one));
+    } while (ret < 0 && errno == EINTR);
+    /* A full nonblocking eventfd is already a wake. It is never drained during
+     * a lease: revocation is terminal, and no new writer may enter afterward. */
+    assert(ret == sizeof(one) || (ret < 0 && errno == EAGAIN));
+}
+
+/* Returns true if no writer may touch the descriptor. */
+static int body_lease_revoke(h2o_http1_body_lease_t *lease, int notify_idle)
+{
+    body_lease_set_error(lease, ECANCELED);
+    unsigned state = atomic_load_explicit(&lease->state, memory_order_acquire);
+    for (;;) {
+        if (state == BODY_LEASE_RETURNED)
+            return 1;
+        if (state == BODY_LEASE_REVOKING)
+            return 0;
+        unsigned next = state == BODY_LEASE_IDLE ? BODY_LEASE_RETURNED : BODY_LEASE_REVOKING;
+        if (atomic_compare_exchange_weak_explicit(&lease->state, &state, next, memory_order_acq_rel, memory_order_acquire)) {
+            if (next == BODY_LEASE_REVOKING) {
+                body_send_cancel(lease);
+                body_lease_wake(lease);
+            } else if (notify_idle && lease->notify != NULL)
+                lease->notify(lease->notify_data);
+            return next == BODY_LEASE_RETURNED;
+        }
+    }
+}
+
+void h2o_http1_body_lease_revoke(h2o_http1_body_lease_t *lease)
+{
+    body_lease_revoke(lease, 1);
+}
+
+static void body_lease_writer_exit(h2o_http1_body_lease_t *lease, int failed)
+{
+    unsigned expected = BODY_LEASE_WRITING;
+    if (!failed && atomic_compare_exchange_strong_explicit(&lease->state, &expected, BODY_LEASE_IDLE,
+                                                           memory_order_release, memory_order_acquire))
+        return;
+    /* RETURNING lets the current frame finish; REVOKING and failure terminate.
+     * Release-publish all accounting before the loop can close or resume I/O. */
+    atomic_store_explicit(&lease->state, BODY_LEASE_RETURNED, memory_order_release);
+    if (lease->notify != NULL)
+        lease->notify(lease->notify_data);
+}
+
+int h2o_http1_body_lease_write(h2o_http1_body_lease_t *lease, const void *data, size_t len, uint64_t deadline_ns,
+                             h2o_http1_body_lease_result_t *result)
+{
+    *result = (h2o_http1_body_lease_result_t){0};
+#if !defined(__linux__) || H2O_USE_LIBUV
+    result->error = ENOTSUP;
+    return 1;
+#else
+    unsigned expected = BODY_LEASE_IDLE;
+    if (!atomic_compare_exchange_strong_explicit(&lease->state, &expected, BODY_LEASE_WRITING,
+                                                 memory_order_acquire, memory_order_relaxed))
+        return 1;
+    atomic_fetch_add_explicit(&lease->refs, 1, memory_order_relaxed); /* Through notify. */
+    if (lease->writer_set && !pthread_equal(lease->writer_thread, pthread_self())) {
+        body_lease_writer_exit(lease, 0);
+        h2o_http1_body_lease_release(lease);
+        return 1;
+    }
+    lease->writer_thread = pthread_self();
+    lease->writer_set = 1;
+    if (len == 0) {
+        body_lease_writer_exit(lease, 0);
+        h2o_http1_body_lease_release(lease);
+        return 0;
+    }
+
+    /* H1 framing remains H2O-owned. Only local vector cursors and the caller's
+     * buffer are used; every nonterminal chunk ends before this API returns. */
+    char prefix_buf[sizeof(size_t) * 2 + 3];
+    h2o_sendvec_t prefix, suffix;
+    if (lease->chunked)
+        encode_chunked(&prefix, &suffix, H2O_SEND_STATE_IN_PROGRESS, len, 0, prefix_buf);
+    else {
+        h2o_sendvec_init_raw(&prefix, NULL, 0);
+        h2o_sendvec_init_raw(&suffix, NULL, 0);
+    }
+    struct iovec iov[3] = {{prefix.raw, prefix.len}, {(void *)data, len}, {suffix.raw, suffix.len}};
+    const size_t prefix_len = prefix.len;
+    atomic_fetch_add_explicit(&lease->payload_submitted, len, memory_order_relaxed);
+    atomic_fetch_add_explicit(&lease->wire_submitted, prefix.len + len + suffix.len, memory_order_relaxed);
+    size_t index = 0;
+    int error = 0;
+    while (index != 3) {
+        while (index != 3 && iov[index].iov_len == 0)
+            ++index;
+        if (index == 3)
+            break;
+        if (atomic_load_explicit(&lease->state, memory_order_acquire) == BODY_LEASE_REVOKING ||
+            (error = atomic_load_explicit(&lease->error, memory_order_acquire)) != 0) {
+            if (error == 0)
+                error = ECANCELED;
+            break;
+        }
+        uint64_t now = body_lease_now(), next_deadline = deadline_ns;
+        if (lease->io_timeout_ns != 0) {
+            uint64_t idle_deadline = body_lease_add_ns(atomic_load_explicit(&lease->last_progress_ns, memory_order_relaxed),
+                                                       lease->io_timeout_ns);
+            if (idle_deadline < next_deadline)
+                next_deadline = idle_deadline;
+        }
+        if (now >= next_deadline) {
+            error = ETIMEDOUT;
+            break;
+        }
+        struct msghdr msg = {.msg_iov = iov + index, .msg_iovlen = 3 - index};
+        if ((error = body_send_enter(lease, next_deadline)) != 0)
+            break;
+        /* Admission can wait. Revalidate this still-pinned call immediately
+         * before kernel I/O, including an expiry or revoke while queued. */
+        if ((error = body_send_terminal(lease, next_deadline)) != 0) {
+            body_send_leave();
+            break;
+        }
+        ssize_t ret = H2O_BODY_LEASE_SENDMSG(lease->fd, &msg, MSG_NOSIGNAL | MSG_DONTWAIT);
+        int send_errno = errno;
+        body_send_leave(); /* No permit during accounting, poll or callbacks. */
+        errno = send_errno;
+        if (ret > 0) {
+            result->wire_bytes += ret;
+            size_t body_end = result->wire_bytes > prefix_len ? result->wire_bytes - prefix_len : 0;
+            result->payload_bytes = body_end < len ? body_end : len;
+            atomic_store_explicit(&lease->last_progress_ns, body_lease_now(), memory_order_relaxed);
+            size_t left = ret;
+            while (index != 3 && left >= iov[index].iov_len) {
+                left -= iov[index].iov_len;
+                ++index;
+            }
+            if (index != 3 && left != 0) {
+                iov[index].iov_base = (char *)iov[index].iov_base + left;
+                iov[index].iov_len -= left;
+            }
+            continue;
+        }
+        if (ret < 0 && errno == EINTR)
+            continue;
+        if (ret == 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+            error = ret == 0 ? EPIPE : errno;
+            break;
+        }
+        uint64_t remaining = next_deadline - now;
+        int timeout = remaining / 1000000 >= INT_MAX ? INT_MAX : (int)((remaining + 999999) / 1000000);
+        struct pollfd fds[2] = {{lease->fd, POLLOUT, 0}, {lease->cancel_fd, POLLIN, 0}};
+        int ready = H2O_BODY_LEASE_POLL(fds, 2, timeout);
+        if (ready < 0 && errno != EINTR) {
+            error = errno;
+            break;
+        }
+        if (ready > 0 && fds[1].revents != 0) {
+            error = ECANCELED;
+            break;
+        }
+        if (ready > 0 && (fds[0].revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
+            error = EPIPE;
+            break;
+        }
+    }
+    if (error != 0)
+        body_lease_set_error(lease, error);
+    result->error = error;
+    body_lease_writer_exit(lease, error != 0);
+    h2o_http1_body_lease_release(lease);
+    return error != 0 ? -1 : 0;
+#endif
+}
diff --git a/lib/http1/chunked-encoder.c.h b/lib/http1/chunked-encoder.c.h
new file mode 100644
index 000000000..d785da05d
--- /dev/null
+++ b/lib/http1/chunked-encoder.c.h
@@ -0,0 +1,26 @@
+static void encode_chunked(h2o_sendvec_t *prefix, h2o_sendvec_t *suffix, h2o_send_state_t state, size_t chunk_size,
+                           int send_trailers, char *buffer)
+{
+    h2o_sendvec_init_raw(prefix, NULL, 0);
+    h2o_sendvec_init_raw(suffix, NULL, 0);
+
+    /* create chunk header and output data */
+    if (chunk_size != 0) {
+        prefix->raw = buffer;
+        prefix->len = sprintf(buffer, "%zx\r\n", chunk_size);
+        if (state != H2O_SEND_STATE_ERROR) {
+            suffix->raw = "\r\n0\r\n\r\n";
+            suffix->len = state == H2O_SEND_STATE_FINAL ? (send_trailers ? 5 : 7) : 2;
+        }
+    } else if (state == H2O_SEND_STATE_FINAL) {
+        suffix->raw = "0\r\n\r\n";
+        suffix->len = send_trailers ? 3 : 5;
+    }
+
+    /* if state is error, send a broken chunk to pass the error down to the browser */
+    if (state == H2O_SEND_STATE_ERROR) {
+        suffix->raw = "\r\n1\r\n";
+        suffix->len = 5;
+    }
+}
+
diff --git a/t/00unit/lib/http1.c b/t/00unit/lib/http1.c
new file mode 100644
index 000000000..1da9b9693
--- /dev/null
+++ b/t/00unit/lib/http1.c
@@ -0,0 +1,598 @@
+/* Exercises the actual H1 state machine, suspended native socket and worker
+ * writer. Deterministic syscall clipping makes partial framing and EAGAIN
+ * independent of kernel send-buffer sizing. No HTTP codec is mocked. */
+#include "../test.h"
+#include <stdatomic.h>
+#include <pthread.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#if defined(__linux__) && !H2O_USE_LIBUV
+static ssize_t lease_test_sendmsg(int fd, const struct msghdr *msg, int flags);
+static int lease_test_poll(struct pollfd *fds, nfds_t count, int timeout);
+#define H2O_BODY_LEASE_SENDMSG lease_test_sendmsg
+#define H2O_BODY_LEASE_POLL lease_test_poll
+#endif
+#include "../../../lib/http1.c"
+
+#if defined(__linux__) && !H2O_USE_LIBUV
+struct lease_fixture;
+struct lease_test_generator {
+    h2o_generator_t super;
+    struct lease_fixture *fixture;
+};
+struct lease_fixture {
+    h2o_globalconf_t conf;
+    h2o_context_t ctx;
+    h2o_loop_t *loop;
+    struct st_h2o_http1_conn_t *conn;
+    h2o_http1_body_lease_t *lease;
+    struct lease_test_generator generator;
+    int peer, fd;
+    unsigned closed, stopped, ready, next_requests;
+    atomic_uint notifications;
+    pthread_t origin;
+};
+static struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    size_t cap;
+    unsigned calls, eagain_once;
+    int force_eagain, poll_entered, pause_after_send, send_paused, resume_send;
+    pthread_t writer;
+} lease_hook = {PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER};
+
+static void lease_hook_reset(void)
+{
+    pthread_mutex_lock(&lease_hook.mutex);
+    lease_hook.cap = SIZE_MAX;
+    lease_hook.calls = lease_hook.eagain_once = 0;
+    lease_hook.force_eagain = lease_hook.poll_entered = lease_hook.pause_after_send = lease_hook.send_paused =
+        lease_hook.resume_send = 0;
+    pthread_mutex_unlock(&lease_hook.mutex);
+}
+
+static ssize_t lease_test_sendmsg(int fd, const struct msghdr *msg, int flags)
+{
+    lease_hook.writer = pthread_self();
+    ++lease_hook.calls;
+    if (lease_hook.force_eagain || (lease_hook.eagain_once && lease_hook.calls == 2)) {
+        errno = EAGAIN;
+        return -1;
+    }
+    struct iovec iov[3];
+    assert(msg->msg_iovlen <= PTLS_ELEMENTSOF(iov));
+    size_t remaining = lease_hook.cap;
+    for (size_t i = 0; i != msg->msg_iovlen; ++i) {
+        iov[i] = msg->msg_iov[i];
+        if (iov[i].iov_len > remaining)
+            iov[i].iov_len = remaining;
+        remaining -= iov[i].iov_len;
+    }
+    struct msghdr clipped = *msg;
+    clipped.msg_iov = iov;
+    ssize_t ret = sendmsg(fd, &clipped, flags);
+    if (lease_hook.pause_after_send && lease_hook.calls == 1) {
+        pthread_mutex_lock(&lease_hook.mutex);
+        lease_hook.send_paused = 1;
+        pthread_cond_broadcast(&lease_hook.cond);
+        while (!lease_hook.resume_send)
+            pthread_cond_wait(&lease_hook.cond, &lease_hook.mutex);
+        pthread_mutex_unlock(&lease_hook.mutex);
+    }
+    return ret;
+}
+
+static int lease_test_poll(struct pollfd *fds, nfds_t count, int timeout)
+{
+    assert(count == 2);
+    pthread_mutex_lock(&lease_hook.mutex);
+    lease_hook.poll_entered = 1;
+    pthread_cond_broadcast(&lease_hook.cond);
+    pthread_mutex_unlock(&lease_hook.mutex);
+    if (lease_hook.force_eagain) {
+        /* Simulate genuine socket backpressure, preserving a real blocking
+         * poll on the lease's cancellation FD and its absolute deadline. */
+        struct pollfd only_cancel = fds[1];
+        int ret = poll(&only_cancel, 1, timeout);
+        fds[0].revents = 0;
+        fds[1].revents = only_cancel.revents;
+        return ret;
+    }
+    return poll(fds, count, timeout);
+}
+
+static void lease_notify(void *p)
+{
+    struct lease_fixture *f = p;
+    atomic_fetch_add_explicit(&f->notifications, 1, memory_order_release);
+}
+static void lease_closed(void *p)
+{
+    struct lease_fixture *f = p;
+    assert(pthread_equal(pthread_self(), f->origin));
+    if (f->lease != NULL) {
+        unsigned state = atomic_load_explicit(&f->lease->state, memory_order_acquire);
+        assert(state != BODY_LEASE_WRITING && state != BODY_LEASE_RETURNING && state != BODY_LEASE_REVOKING);
+    }
+    ++f->closed;
+    f->conn = NULL;
+}
+static void lease_proceed(h2o_generator_t *g, h2o_req_t *req)
+{
+    struct lease_test_generator *generator = (void *)g;
+    ++generator->fixture->ready;
+}
+static void lease_stop(h2o_generator_t *g, h2o_req_t *req)
+{
+    struct lease_test_generator *generator = (void *)g;
+    assert(pthread_equal(pthread_self(), generator->fixture->origin));
+    ++generator->fixture->stopped;
+}
+static int lease_next_request(h2o_handler_t *handler, h2o_req_t *req)
+{
+    struct lease_fixture *f = req->conn->ctx->storage.entries[0].data;
+    ++f->next_requests;
+    req->res.status = 200;
+    req->res.reason = "OK";
+    h2o_send_inline(req, H2O_STRLIT("next"));
+    return 0;
+}
+static void lease_fixture_init(struct lease_fixture *f)
+{
+    memset(f, 0, sizeof(*f));
+    atomic_init(&f->notifications, 0);
+    f->origin = pthread_self();
+    lease_hook_reset();
+    f->loop = h2o_evloop_create();
+    h2o_config_init(&f->conf);
+    f->conf.http1.req_io_timeout = 1000;
+    h2o_hostconf_t *host = h2o_config_register_host(&f->conf, h2o_iovec_init(H2O_STRLIT("default")), 65535);
+    h2o_pathconf_t *path = h2o_config_register_path(host, "/", 0);
+    h2o_handler_t *handler = h2o_create_handler(path, sizeof(*handler));
+    handler->on_req = lease_next_request;
+    h2o_context_init(&f->ctx, f->loop, &f->conf);
+    /* Test handler's fixture lookup uses the real context storage API. */
+    h2o_vector_reserve(NULL, &f->ctx.storage, 1);
+    f->ctx.storage.size = 1;
+    f->ctx.storage.entries[0] = (h2o_context_storage_item_t){.data = f};
+    int pair[2];
+    assert(socketpair(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0, pair) == 0);
+    f->fd = pair[0];
+    f->peer = pair[1];
+    h2o_socket_t *sock = h2o_evloop_socket_create(f->loop, pair[0], 0);
+    sock->on_close.cb = lease_closed;
+    sock->on_close.data = f;
+    f->conn = (void *)h2o_create_connection(sizeof(*f->conn), &f->ctx, f->conf.hosts, (struct timeval){0}, &h1_callbacks);
+    memset((char *)f->conn + sizeof(f->conn->super), 0, offsetof(struct st_h2o_http1_conn_t, req) - sizeof(f->conn->super));
+    f->conn->sock = sock;
+    sock->data = f->conn;
+    init_request(f->conn);
+    h2o_req_t *req = &f->conn->req;
+    req->version = 0x101;
+    req->input.method = req->method = h2o_iovec_init(H2O_STRLIT("GET"));
+    req->input.path = req->path = h2o_iovec_init(H2O_STRLIT("/"));
+    req->input.authority = req->authority = h2o_iovec_init(H2O_STRLIT("default"));
+    req->input.scheme = req->scheme = &H2O_URL_SCHEME_HTTP;
+    req->http1_is_persistent = 1;
+    req->res.status = 200;
+    req->res.reason = "OK";
+    req->res.content_length = SIZE_MAX;
+    h2o_req_bind_conf(req, host, path);
+    f->generator.super.proceed = lease_proceed;
+    f->generator.super.stop = lease_stop;
+    f->generator.fixture = f;
+    h2o_start_response(req, &f->generator.super);
+}
+static size_t lease_read_peer(struct lease_fixture *f, char *dst, size_t capacity)
+{
+    size_t len = 0;
+    ssize_t ret;
+    while (len != capacity && (ret = recv(f->peer, dst + len, capacity - len, MSG_DONTWAIT)) > 0)
+        len += ret;
+    return len;
+}
+static void lease_flush_headers(struct lease_fixture *f)
+{
+    h2o_send(&f->conn->req, NULL, 0, H2O_SEND_STATE_IN_PROGRESS);
+    ok(h2o_http1_body_lease_acquire(&f->conn->req, lease_notify, f) == NULL);
+    for (unsigned i = 0; f->ready == 0 && i != 8; ++i)
+        h2o_evloop_run(f->loop, 0);
+    ok(f->ready == 1);
+    char headers[4096];
+    ok(lease_read_peer(f, headers, sizeof(headers)) != 0);
+}
+static void lease_grant(struct lease_fixture *f)
+{
+    lease_flush_headers(f);
+    f->lease = h2o_http1_body_lease_acquire(&f->conn->req, lease_notify, f);
+    ok(f->lease != NULL);
+}
+static void lease_fixture_dispose(struct lease_fixture *f)
+{
+    if (f->lease != NULL) {
+        assert(h2o_http1_body_lease_return(f->lease) == 1);
+        h2o_http1_body_lease_release(f->lease);
+        f->lease = NULL;
+    }
+    if (f->conn != NULL)
+        close_connection(f->conn, 1);
+    h2o_evloop_run(f->loop, 0);
+    if (f->peer >= 0)
+        close(f->peer);
+    h2o_context_dispose(&f->ctx);
+    h2o_config_dispose(&f->conf);
+    h2o_evloop_destroy(f->loop);
+}
+struct lease_job {
+    h2o_http1_body_lease_t *lease;
+    const char *bytes;
+    size_t len;
+    uint64_t deadline;
+    int twice, ret;
+    h2o_http1_body_lease_result_t result;
+};
+static void *lease_worker(void *p)
+{
+    struct lease_job *job = p;
+    job->ret = h2o_http1_body_lease_write(job->lease, job->bytes, job->len, job->deadline, &job->result);
+    if (job->twice) {
+        assert(job->ret == 0);
+        char second[] = "xy";
+        job->ret = h2o_http1_body_lease_write(job->lease, second, 2, job->deadline, &job->result);
+        memset(second, '!', 2); /* No borrowed byte survives the write return. */
+    }
+    return NULL;
+}
+static pthread_t lease_start_worker(struct lease_job *job)
+{
+    pthread_t thread;
+    assert(pthread_create(&thread, NULL, lease_worker, job) == 0);
+    return thread;
+}
+static void lease_wait_hook(int *flag)
+{
+    pthread_mutex_lock(&lease_hook.mutex);
+    struct timespec until;
+    clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_sec += 2;
+    while (!*flag)
+        assert(pthread_cond_timedwait(&lease_hook.cond, &lease_hook.mutex, &until) == 0);
+    pthread_mutex_unlock(&lease_hook.mutex);
+}
+
+static void lease_test_eligibility(void)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    ok(h2o_http1_body_lease_acquire(&f.conn->req, lease_notify, &f) == NULL); /* Headers unflushed. */
+    lease_flush_headers(&f);
+    h2o_req_t *req = &f.conn->req;
+    req->version = 0x200;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    req->version = 0x101;
+    req->is_tunnel_req = 1;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    req->is_tunnel_req = 0;
+    req->proceed_req = (void *)1;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    req->proceed_req = NULL;
+    f.conn->_req_entity_reader = (void *)1;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    f.conn->_req_entity_reader = NULL;
+    req->input.method = h2o_iovec_init(H2O_STRLIT("HEAD"));
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    req->input.method = req->method;
+    h2o_ostream_t filter = {0};
+    req->_ostr_top = &filter;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    req->_ostr_top = &f.conn->_ostr_final.super;
+    f.conn->sock->ssl = (void *)1;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    f.conn->sock->ssl = NULL;
+    f.conn->_ostr_final.informational.write_inflight = 1;
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    f.conn->_ostr_final.informational.write_inflight = 0;
+    f.lease = h2o_http1_body_lease_acquire(req, lease_notify, &f);
+    ok(f.lease != NULL);
+    ok(h2o_http1_body_lease_acquire(req, lease_notify, &f) == NULL);
+    lease_fixture_dispose(&f);
+}
+static void lease_test_partial_and_owner(void)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    lease_grant(&f);
+    lease_hook.cap = 1;
+    lease_hook.eagain_once = 1;
+    char first[] = "abcdef";
+    struct lease_job job = {.lease = f.lease, .bytes = first, .len = 6, .deadline = UINT64_MAX, .twice = 1};
+    pthread_t thread = lease_start_worker(&job);
+    assert(pthread_join(thread, NULL) == 0);
+    ok(job.ret == 0 && job.result.payload_bytes == 2);
+    ok(!pthread_equal(lease_hook.writer, f.origin)); /* Kernel send ran on worker. */
+    ok(lease_hook.calls > 10 && lease_hook.poll_entered);
+    ok(atomic_load(&f.notifications) == 0); /* No normal-write actor handoff. */
+    memset(first, '!', 6);
+    h2o_http1_body_lease_result_t refused;
+    ok(h2o_http1_body_lease_write(f.lease, "wrong", 5, UINT64_MAX, &refused) == 1);
+    ok(refused.wire_bytes == 0);
+    char wire[128];
+    size_t len = lease_read_peer(&f, wire, sizeof(wire));
+    ok(h2o_memis(wire, len, H2O_STRLIT("6\r\nabcdef\r\n2\r\nxy\r\n")));
+    ok(h2o_http1_body_lease_return(f.lease) == 1);
+    ok(f.conn->req.bytes_sent == 8);
+    lease_fixture_dispose(&f);
+}
+static void lease_test_active_close(int kind)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    lease_grant(&f);
+    lease_hook.force_eagain = 1;
+    struct lease_job job = {.lease = f.lease, .bytes = "body", .len = 4, .deadline = UINT64_MAX};
+    pthread_t thread = lease_start_worker(&job);
+    lease_wait_hook(&lease_hook.poll_entered);
+    if (kind == 0)
+        close_connection(f.conn, 1);
+    else if (kind == 1)
+        close_idle_connection(&f.conn->super); /* Stop/forced context close. */
+    else
+        reqread_on_timeout(&f.conn->_timeout_entry);
+    ok(f.conn != NULL && f.closed == 0 && f.stopped == 0);
+    ok(fcntl(f.fd, F_GETFD) != -1); /* Descriptor and request remain alive. */
+    assert(pthread_join(thread, NULL) == 0);
+    ok(job.ret == -1 && job.result.error == ECANCELED);
+    ok(atomic_load(&f.notifications) == 1);
+    ok(h2o_http1_body_lease_return(f.lease) == 1);
+    ok(f.conn == NULL && f.closed == 1 && f.stopped == 1);
+    ok(fcntl(f.fd, F_GETFD) == -1 && errno == EBADF);
+    ok(h2o_http1_body_lease_return(f.lease) == 1); /* Safe after request destruction. */
+    lease_fixture_dispose(&f);
+}
+static void lease_test_orderly_return(void)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    lease_grant(&f);
+    lease_hook.cap = 1;
+    lease_hook.pause_after_send = 1;
+    struct lease_job job = {.lease = f.lease, .bytes = "body", .len = 4, .deadline = UINT64_MAX};
+    pthread_t thread = lease_start_worker(&job);
+    lease_wait_hook(&lease_hook.send_paused);
+    ok(h2o_http1_body_lease_return(f.lease) == 0);
+    ok(f.conn != NULL && f.closed == 0 && f.stopped == 0);
+    pthread_mutex_lock(&lease_hook.mutex);
+    lease_hook.resume_send = 1;
+    pthread_cond_broadcast(&lease_hook.cond);
+    pthread_mutex_unlock(&lease_hook.mutex);
+    assert(pthread_join(thread, NULL) == 0);
+    ok(job.ret == 0 && job.result.payload_bytes == 4);
+    ok(atomic_load(&f.notifications) == 1);
+    ok(h2o_http1_body_lease_return(f.lease) == 1);
+    ok(f.conn != NULL && f.closed == 0);
+    char wire[128];
+    ok(h2o_memis(wire, lease_read_peer(&f, wire, sizeof(wire)), H2O_STRLIT("4\r\nbody\r\n")));
+    lease_fixture_dispose(&f);
+}
+static void lease_test_timeout_and_peer(void)
+{
+    for (unsigned peer = 0; peer != 2; ++peer) {
+        struct lease_fixture f;
+        lease_fixture_init(&f);
+        lease_grant(&f);
+        if (peer) {
+            close(f.peer);
+            f.peer = -1;
+        } else {
+            lease_hook.force_eagain = 1;
+        }
+        struct lease_job job = {.lease = f.lease, .bytes = "body", .len = 4,
+                               .deadline = peer ? UINT64_MAX : body_lease_now() + 20000000};
+        pthread_t thread = lease_start_worker(&job);
+        assert(pthread_join(thread, NULL) == 0);
+        ok(job.ret == -1 && job.result.error == (peer ? EPIPE : ETIMEDOUT));
+        ok(atomic_load(&f.notifications) == 1);
+        ok(f.conn != NULL && f.closed == 0);
+        ok(h2o_http1_body_lease_return(f.lease) == 1);
+        ok(f.conn == NULL && f.closed == 1 && f.stopped == 1);
+        lease_fixture_dispose(&f);
+    }
+}
+static void lease_test_idle_revoke(void)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    lease_grant(&f);
+    h2o_http1_body_lease_revoke(f.lease);
+    h2o_http1_body_lease_revoke(f.lease);
+    ok(atomic_load(&f.notifications) == 1);
+    ok(h2o_http1_body_lease_return(f.lease) == 1);
+    ok(f.closed == 1 && f.stopped == 1);
+    lease_fixture_dispose(&f);
+}
+static void lease_test_pipeline(void)
+{
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    lease_grant(&f);
+    const char next[] = "GET /next HTTP/1.1\r\nHost: default\r\nConnection: close\r\n\r\n";
+    ssize_t next_sent = send(f.peer, next, sizeof(next) - 1, MSG_NOSIGNAL);
+    if (next_sent != sizeof(next) - 1)
+        fprintf(stderr, "pipeline send: fd=%d peer=%d ret=%zd errno=%d closed=%u\n", f.fd, f.peer, next_sent, errno, f.closed);
+    assert(next_sent == sizeof(next) - 1);
+    for (unsigned i = 0; i != 3; ++i)
+        h2o_evloop_run(f.loop, 0);
+    ok(f.next_requests == 0 && f.conn->sock->input->size == 0);
+    struct lease_job job = {.lease = f.lease, .bytes = "body", .len = 4, .deadline = UINT64_MAX};
+    pthread_t thread = lease_start_worker(&job);
+    assert(pthread_join(thread, NULL) == 0);
+    ok(job.ret == 0);
+    ok(h2o_http1_body_lease_return(f.lease) == 1);
+    h2o_send(&f.conn->req, NULL, 0, H2O_SEND_STATE_FINAL); /* H2O owns the terminal chunk. */
+    for (unsigned i = 0; f.closed == 0 && i != 16; ++i)
+        h2o_evloop_run(f.loop, 0);
+    ok(f.next_requests == 1 && f.closed == 1);
+    char wire[4096];
+    size_t len = lease_read_peer(&f, wire, sizeof(wire));
+    ok(len > 32 && memcmp(wire, "4\r\nbody\r\n0\r\n\r\nHTTP/1.1 200", sizeof("4\r\nbody\r\n0\r\n\r\nHTTP/1.1 200") - 1) == 0);
+    lease_fixture_dispose(&f);
+}
+
+struct input_take_case {
+    struct lease_fixture *fixture;
+    h2o_buffer_t *held[3];
+    size_t lengths[3];
+    unsigned calls, suffix;
+};
+static int input_take_fragment(void *p, int complete)
+{
+    struct input_take_case *test = p;
+    struct st_h2o_http1_conn_t *conn = test->fixture->conn;
+    h2o_req_t *req = &conn->req;
+    unsigned index = test->calls++;
+    ok(index < PTLS_ELEMENTSOF(test->held));
+    test->lengths[index] = req->entity.len;
+    /* EOF is cleared before entering the callback, including when a final
+     * suffix must wait for this response. Nonfinal proceed stays installed. */
+    ok(complete ? req->proceed_req == NULL : req->proceed_req == proceed_request);
+    h2o_buffer_t *body = conn->req_body;
+    test->held[index] = h2o_http1_take_request_body(req);
+    if (complete && test->suffix) {
+        ok(test->held[index] == NULL && conn->req_body == body);
+    } else {
+        ok(test->held[index] == body && req->entity.len == 0 && req->entity.base == NULL);
+        ok(conn->req_body != body && conn->req_body->size == 0);
+    }
+    if (!complete)
+        req->proceed_req(req, NULL); /* acknowledges only the empty replacement */
+    return 0;
+}
+static void input_test_nonfinal_take(void)
+{
+    const size_t prefix = 256 * 1024;
+    char *bytes = h2o_mem_alloc(prefix);
+    memset(bytes, 'P', prefix);
+    for (unsigned suffix = 0; suffix != 2; ++suffix) {
+        struct lease_fixture f;
+        lease_fixture_init(&f);
+        struct input_take_case test = {.fixture = &f, .suffix = suffix};
+        h2o_req_t *req = &f.conn->req;
+        create_content_length_entity_reader(f.conn, prefix * 2 + 17);
+        h2o_buffer_init(&f.conn->req_body, &h2o_socket_buffer_prototype);
+        req->write_req.cb = input_take_fragment;
+        req->write_req.ctx = &test;
+        req->proceed_req = proceed_request;
+        for (unsigned i = 0; i != 2; ++i) {
+            h2o_buffer_append(&f.conn->sock->input, bytes, prefix);
+            handle_content_length_entity_read(f.conn);
+            ok(test.calls == i + 1 && test.lengths[i] == prefix);
+            ok(req->req_body_bytes_received == prefix * (i + 1));
+            ok(req->proceed_req == proceed_request && f.conn->_req_entity_reader != NULL);
+            ok(test.held[i]->size == prefix && test.held[i]->bytes[0] == 'P');
+        }
+        h2o_buffer_append(&f.conn->sock->input, H2O_STRLIT("final-body-prefix"));
+        if (suffix)
+            h2o_buffer_append(&f.conn->sock->input, H2O_STRLIT("GET /next HTTP/1.1\r\nHost: default\r\n\r\n"));
+        handle_content_length_entity_read(f.conn);
+        ok(test.calls == 3 && test.lengths[2] == 17);
+        ok(req->req_body_bytes_received == prefix * 2 + 17);
+        ok(req->proceed_req == NULL && f.conn->_req_entity_reader == NULL);
+        ok(f.next_requests == 0 && f.conn->sock->input->size == (suffix ? 37 : 0));
+        /* Detached prefixes remain readable even after another fragment and
+         * connection disposal; only the original loop returns their storage. */
+        lease_fixture_dispose(&f);
+        for (unsigned i = 0; i != 3; ++i) {
+            if (test.held[i] == NULL)
+                continue;
+            ok(test.held[i]->size == test.lengths[i]);
+            ok(memcmp(test.held[i]->bytes, i == 2 ? "final-body-prefix" : bytes, test.lengths[i]) == 0);
+            h2o_buffer_dispose(&test.held[i]);
+        }
+    }
+    free(bytes);
+}
+
+struct input_restore_case {
+    h2o_req_t *req;
+    h2o_buffer_t *held;
+    unsigned calls;
+    int complete;
+};
+static int input_hold_fragment(void *p, int complete)
+{
+    struct input_restore_case *test = p;
+    ++test->calls;
+    test->complete = complete;
+    test->held = h2o_http1_take_request_body(test->req);
+    ok(test->held != NULL);
+    return 0; /* consumption and proceed are deliberately deferred */
+}
+static void input_test_nonfinal_restore(void)
+{
+    const size_t prefix = 256 * 1024;
+    char *bytes = h2o_mem_alloc(prefix);
+    memset(bytes, 'R', prefix);
+    struct lease_fixture f;
+    lease_fixture_init(&f);
+    h2o_req_t *req = &f.conn->req;
+    struct input_restore_case test = {.req = req};
+    create_content_length_entity_reader(f.conn, prefix * 2 + 17);
+    h2o_buffer_init(&f.conn->req_body, &h2o_socket_buffer_prototype);
+    req->write_req.cb = input_hold_fragment;
+    req->write_req.ctx = &test;
+    req->proceed_req = proceed_request;
+    h2o_buffer_t *warm = NULL;
+    size_t capacity = 0;
+    for (unsigned i = 0; i != 2; ++i) {
+        h2o_buffer_append(&f.conn->sock->input, bytes, prefix);
+        if (i == 0) {
+            warm = f.conn->sock->input;
+            capacity = warm->capacity;
+        }
+        ok(f.conn->sock->input == warm);
+        handle_content_length_entity_read(f.conn);
+        ok(test.calls == i + 1 && !test.complete && test.held == warm);
+        ok(req->proceed_req == proceed_request && req->entity.len == 0 && req->entity.base == NULL);
+        ok(test.held->size == prefix && memcmp(test.held->bytes, bytes, prefix) == 0);
+        ok(f.conn->sock->input != warm && f.conn->sock->input->size == 0);
+        /* An unexpected occupied input must refuse without taking ownership. */
+        h2o_buffer_append(&f.conn->sock->input, H2O_STRLIT("x"));
+        ok(!h2o_http1_restore_request_body(req, &test.held) && test.held == warm);
+        h2o_buffer_consume(&f.conn->sock->input, 1);
+        ok(h2o_http1_restore_request_body(req, &test.held));
+        ok(test.held == NULL && f.conn->sock->input == warm);
+        ok(warm->capacity == capacity && warm->size == 0 && warm->bytes == warm->_buf);
+        req->proceed_req(req, NULL);
+        ok(f.conn->sock->input == warm && warm->size == 0);
+    }
+    h2o_buffer_append(&f.conn->sock->input, H2O_STRLIT("final-body-prefix"));
+    ok(f.conn->sock->input == warm);
+    handle_content_length_entity_read(f.conn);
+    ok(test.calls == 3 && test.complete && test.held == warm);
+    ok(req->proceed_req == NULL && f.conn->_req_entity_reader == NULL);
+    ok(!h2o_http1_restore_request_body(req, &test.held) && test.held == warm);
+    lease_fixture_dispose(&f);
+    /* A final or orphaned return is disposed independently of the old pool. */
+    ok(test.held->size == 17 && memcmp(test.held->bytes, "final-body-prefix", 17) == 0);
+    h2o_buffer_dispose(&test.held);
+    free(bytes);
+}
+#endif
+
+void test_lib__http1_body_lease(void)
+{
+#if defined(__linux__) && !H2O_USE_LIBUV
+    subtest("input/nonfinal-take/EOF/suffix/lifetime", input_test_nonfinal_take);
+    subtest("input/nonfinal-restore/same-allocation/deferred-proceed", input_test_nonfinal_restore);
+    subtest("eligibility", lease_test_eligibility);
+    subtest("partial/EAGAIN/worker/caller-lifetime", lease_test_partial_and_owner);
+    lease_test_active_close(0);
+    lease_test_active_close(1);
+    lease_test_active_close(2);
+    subtest("orderly-return", lease_test_orderly_return);
+    subtest("timeout/peer-close", lease_test_timeout_and_peer);
+    subtest("idle-revoke", lease_test_idle_revoke);
+    subtest("pipeline/final-framing", lease_test_pipeline);
+#endif
+}
