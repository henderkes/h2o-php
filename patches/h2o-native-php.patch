+#if !H2O_USE_LIBUV && defined(FIONREAD)
+#undef h2o_buffer_try_reserve
+#undef ioctl
+
+static struct {
+    int enabled;
+    int ioctl_mode; /* 0: real, 1: unsupported, 2: zero, 3: negative */
+    size_t queries;
+    size_t growths;
+    size_t growth_bytes;
+    int script_fd;
+    size_t script_size;
+} read_observer;
+
+static h2o_iovec_t observe_read_reserve(h2o_buffer_t **input, size_t min_guarantee)
+{
+    size_t old_size = (*input)->size, old_capacity = (*input)->capacity;
+    int allocated = (*input)->bytes != NULL;
+    h2o_iovec_t result = h2o_buffer_try_reserve(input, min_guarantee);
+    if (read_observer.enabled && allocated && (*input)->capacity > old_capacity) {
+        ++read_observer.growths;
+        read_observer.growth_bytes += old_size;
+    }
+    return result;
+}
+
+static int observe_read_ioctl(int fd, unsigned long request, void *argument)
+{
+    if (read_observer.script_size != 0 && fd == read_observer.script_fd) {
+        ++read_observer.queries;
+        *(int *)argument = read_observer.script_size - lseek(fd, 0, SEEK_CUR);
+        return 0;
+    }
+    if (read_observer.enabled) {
+        ++read_observer.queries;
+        switch (read_observer.ioctl_mode) {
+        case 1:
+            errno = ENOTTY;
+            return -1;
+        case 2:
+            *(int *)argument = 0;
+            return 0;
+        case 3:
+            *(int *)argument = -1;
+            return 0;
+        }
+    }
+    return ioctl(fd, request, argument);
+}
+
+static void test_read_growth(void)
+{
+    char payload[65536];
+    for (size_t i = 0; i != sizeof(payload); ++i)
+        payload[i] = (char)i;
+
+    for (int mode = 0; mode != 4; ++mode) {
+        int fds[2];
+        h2o_buffer_t *input;
+        h2o_buffer_init(&input, &h2o_socket_buffer_prototype);
+        size_t initial_capacity = h2o_buffer_reserve(&input, 4096).len;
+        h2o_buffer_dispose(&input);
+        h2o_buffer_init(&input, &h2o_socket_buffer_prototype);
+        ok(socketpair(AF_UNIX, SOCK_STREAM, 0, fds) == 0);
+        ok(fcntl(fds[0], F_SETFL, O_NONBLOCK) == 0);
+        ok(write(fds[1], payload, sizeof(payload)) == sizeof(payload));
+        ok(shutdown(fds[1], SHUT_WR) == 0);
+        memset(&read_observer, 0, sizeof(read_observer));
+        read_observer.enabled = 1;
+        read_observer.ioctl_mode = mode;
+
+        ok(on_read_core(fds[0], &input, sizeof(payload)) == NULL);
+        if (mode == 2) {
+            /* A zero hint after a full read must not cause speculative growth.
+             * Bytes arriving after that snapshot remain for the next read. */
+            ok(input->size == initial_capacity);
+            ok(read_observer.growths == 0);
+            read_observer.ioctl_mode = 0;
+            ok(on_read_core(fds[0], &input, sizeof(payload) - input->size) == NULL);
+        }
+        ok(input->size == sizeof(payload));
+        ok(memcmp(input->bytes, payload, sizeof(payload)) == 0);
+        if (mode == 0) {
+            ok(read_observer.queries == 1);
+            ok(read_observer.growths == 1);
+            ok(read_observer.growth_bytes == initial_capacity);
+        } else if (mode == 1 || mode == 3) {
+            /* Unsupported or invalid hints retain geometric growth. */
+            ok(read_observer.growths > 1);
+            ok(read_observer.growth_bytes > initial_capacity);
+        }
+        ok(on_read_core(fds[0], &input, sizeof(payload)) == h2o_socket_error_closed);
+        read_observer.enabled = 0;
+        h2o_buffer_dispose(&input);
+        close(fds[0]);
+        close(fds[1]);
+    }
+}
+
+/* Only FIONREAD is scripted. A finite temporary file supplies exact read
+ * lengths to the production read, reserve, memcpy, recycle and dispatch paths,
+ * independent of socket send-buffer capacity or scheduler timing. */
+static size_t warm_callbacks;
+static const char *warm_error;
+static void observe_warm_callback(h2o_socket_t *sock, const char *error)
+{
+    (void)sock;
+    ++warm_callbacks;
+    warm_error = error;
+}
+static FILE *warm_read_file(const char *payload, size_t length)
+{
+    FILE *file = tmpfile();
+    assert(file != NULL && fwrite(payload, 1, length, file) == length && fflush(file) == 0);
+    rewind(file);
+    return file;
+}
+static void test_restored_input_read_bound(void)
+{
+    const size_t length = 1024 * 1024;
+    char *payload = h2o_mem_alloc(length);
+    for (size_t i = 0; i != length; ++i) payload[i] = (char)i;
+    size_t control_copy = 0, warm_capacity = 0;
+    for (unsigned bounded = 0; bounded != 2; ++bounded) {
+        FILE *file = warm_read_file(payload, length);
+        struct st_h2o_evloop_socket_t sock = {.fd = fileno(file), .max_read_size = length};
+        h2o_buffer_init(&sock.super.input, &h2o_socket_buffer_prototype);
+        h2o_buffer_reserve(&sock.super.input, 256 * 1024);
+        h2o_buffer_t *warm = sock.super.input;
+        warm_capacity = warm->capacity;
+        sock.super._cb.read = observe_warm_callback;
+        memset(&read_observer, 0, sizeof(read_observer));
+        read_observer.enabled = 1;
+        read_observer.script_fd = sock.fd;
+        read_observer.script_size = length;
+        warm_callbacks = 0; warm_error = NULL;
+        if (bounded) h2o_evloop_socket_read_current_buffer(&sock.super);
+        read_on_ready(&sock);
+        ok(warm_callbacks == 1 && warm_error == NULL);
+        ok(sock.max_read_size == length && !sock.read_current_buffer);
+        if (!bounded) {
+            /* Old restore behavior: the second read grows the input and copies
+             * the whole just-filled warm allocation before H1 sees any data. */
+            ok(sock.super.input->size == length && sock.super.input != warm);
+            ok(read_observer.growths == 1 && read_observer.growth_bytes == warm_capacity);
+            control_copy = read_observer.growth_bytes;
+        } else {
+            ok(sock.super.input == warm && warm->size == warm_capacity);
+            ok(read_observer.growths == 0 && read_observer.growth_bytes == 0);
+            ok(memcmp(warm->bytes, payload, warm_capacity) == 0);
+            /* Model origin-loop return after consumption. Every subsequent
+             * bounded read reuses this exact allocation without growth. */
+            size_t received = warm_capacity;
+            while (received != length) {
+                warm->size = 0; warm->bytes = warm->_buf;
+                h2o_evloop_socket_read_current_buffer(&sock.super);
+                read_on_ready(&sock);
+                ok(sock.super.input == warm && warm_error == NULL);
+                ok(memcmp(warm->bytes, payload + received, warm->size) == 0);
+                received += warm->size;
+            }
+            ok(read_observer.growths == 0 && read_observer.growth_bytes == 0);
+            /* An exact-full read delivers data before EOF is reported on the
+             * following callback. No synthetic EOF accompanies the fragment. */
+            ok(ftruncate(sock.fd, warm_capacity) == 0 && lseek(sock.fd, 0, SEEK_SET) == 0);
+            read_observer.script_size = warm_capacity;
+            warm->size = 0; warm->bytes = warm->_buf;
+            h2o_evloop_socket_read_current_buffer(&sock.super);
+            read_on_ready(&sock);
+            ok(!sock.read_current_buffer && warm_error == NULL && warm->size == warm_capacity);
+            warm->size = 0; warm->bytes = warm->_buf;
+            read_on_ready(&sock);
+            ok(warm_error == h2o_socket_error_closed);
+        }
+        read_observer.enabled = 0;
+        h2o_buffer_dispose(&sock.super.input);
+        fclose(file);
+    }
+    fprintf(stderr, "HP_WARM_READ_BOUND capacity=%zu control_copy_bytes=%zu bounded_copy_bytes=0\n", warm_capacity, control_copy);
+
+    /* Ordinary concrete small and partial inputs never opt in. They keep the
+     * existing FIONREAD coalescing and growth behavior for large uploads. */
+    for (unsigned partial = 0; partial != 2; ++partial) {
+        FILE *file = warm_read_file(payload, length);
+        struct st_h2o_evloop_socket_t sock = {.fd = fileno(file), .max_read_size = length};
+        h2o_buffer_init(&sock.super.input, &h2o_socket_buffer_prototype);
+        h2o_buffer_reserve(&sock.super.input, 4096);
+        if (partial) {
+            memcpy(sock.super.input->bytes, payload, 17); sock.super.input->size = 17;
+            assert(lseek(sock.fd, 17, SEEK_SET) == 17);
+        }
+        sock.super._cb.read = observe_warm_callback;
+        memset(&read_observer, 0, sizeof(read_observer));
+        read_observer.enabled = 1; read_observer.script_fd = sock.fd; read_observer.script_size = length;
+        read_on_ready(&sock);
+        ok(sock.super.input->size == length && warm_error == NULL);
+        ok(read_observer.growths == 1 && read_observer.growth_bytes != 0);
+        ok(memcmp(sock.super.input->bytes, payload, length) == 0);
+        read_observer.enabled = 0; h2o_buffer_dispose(&sock.super.input); fclose(file);
+    }
+    /* Real nonblocking socket: an empty readiness attempt preserves the bound
+     * until a positive read, without changing the configured callback limit. */
+    int pair[2];
+    ok(socketpair(AF_UNIX, SOCK_STREAM, 0, pair) == 0);
+    ok(fcntl(pair[0], F_SETFL, O_NONBLOCK) == 0);
+    struct st_h2o_evloop_socket_t sock = {.fd = pair[0], .max_read_size = length};
+    h2o_buffer_init(&sock.super.input, &h2o_socket_buffer_prototype);
+    h2o_buffer_reserve(&sock.super.input, 4096);
+    sock.super._cb.read = observe_warm_callback;
+    h2o_evloop_socket_read_current_buffer(&sock.super);
+    read_on_ready(&sock);
+    ok(sock.read_current_buffer && warm_error == NULL && sock.super.input->size == 0);
+    ok(write(pair[1], payload, 1) == 1);
+    read_on_ready(&sock);
+    ok(!sock.read_current_buffer && warm_error == NULL && sock.super.input->size == 1);
+    ok(sock.max_read_size == length && sock.super.input->bytes[0] == payload[0]);
+    h2o_buffer_dispose(&sock.super.input); close(pair[0]); close(pair[1]);
