+    if (conn->super.ctx->shutdown_requested && conn->num_streams.pull.open == 0 &&
+        conn->num_streams.pull.half_closed == 0 && conn->num_streams.push.open == 0 &&
+        conn->num_streams.push.half_closed == 0) {
+        if (h2o_timer_is_linked(&conn->_write.timeout_entry))
+            h2o_timer_unlink(&conn->_write.timeout_entry);
+        close_connection_now(conn);
+    }
+}
