+/* Private native-host extension: detach a whole decoded Content-Length
+ * fragment's heap buffer, or return NULL without changing the request. This
+ * does not imply EOF; the caller retains the actual write_req EOF flag and
+ * acknowledges a nonfinal fragment with proceed_req as usual. The caller must
+ * dispose the returned allocation on this owning loop; it is no longer owned
+ * by the connection or its request pool.
+ * TLS, chunked, tunnels and pipelined input retain the ordinary copy path. */
+h2o_buffer_t *h2o_http1_take_request_body(h2o_req_t *req);
+/* Return an exhausted nonfinal take to its still-live, paused request on the
+ * owning loop, before proceed_req. On success the existing socket input owns
+ * the warm allocation and *body is NULL. On refusal the caller still owns it.
+ * The caller must separately ensure the request pool is live; an external
+ * native request reference alone does not retain that pool. */
+int h2o_http1_restore_request_body(h2o_req_t *req, h2o_buffer_t **body);
+
+
+/* Private native-host body writer. Only native Linux epoll, plain H1, completed
+ * request input and an unfiltered, header-flushed response can acquire a lease.
+ * Acquire/return run on the owning loop. The opaque token has a caller reference
+ * in addition to H1's reference; release the caller reference after return says
+ * detached. The token remains valid after an idle abort destroys the request.
+ * No worker API accesses request/connection/socket-wrapper storage. */
+typedef struct st_h2o_http1_body_lease_t h2o_http1_body_lease_t;
+typedef struct st_h2o_http1_body_lease_result_t {
+    size_t payload_bytes, wire_bytes;
+    int error;
+} h2o_http1_body_lease_result_t;
+/* Optional cold-start resource discovery. Call once before spawning workers
+ * or pinning loops; absent/unsupported discovery keeps unrestricted sends. */
+void h2o_http1_body_lease_startup(void);
+size_t h2o_http1_body_lease_charge(void);
+h2o_http1_body_lease_t *h2o_http1_body_lease_acquire(h2o_req_t *req, void (*notify)(void *), void *data);
+/* Worker only: 0 = complete, 1 = refused before any I/O, -1 = terminal failure.
+ * deadline_ns is absolute CLOCK_MONOTONIC (UINT64_MAX disables that deadline).
+ * Payload and framing are fully consumed before return; no caller bytes survive
+ * the call. A terminal failure must never be retried through owned output.
+ * The first accepted writer pthread remains the sole permitted writer. */
+int h2o_http1_body_lease_write(h2o_http1_body_lease_t *, const void *, size_t, uint64_t deadline_ns,
+                             h2o_http1_body_lease_result_t *);
+/* Terminal cancellation, any thread. notify is thread-safe publication ONLY;
+ * it is called once idle, or after the active writer has stopped touching I/O.
+ * A normal completed write has no notification or loop handoff. */
+void h2o_http1_body_lease_revoke(h2o_http1_body_lease_t *);
+/* Loop only: 1 = detached, 0 = active frame finishing (notify will follow).
+ * This can synchronously destroy req/conn after an abort or failed write.
+ * Orderly return lets an active frame complete; revoke interrupts it. */
+int h2o_http1_body_lease_return(h2o_http1_body_lease_t *);
+void h2o_http1_body_lease_release(h2o_http1_body_lease_t *);
 
