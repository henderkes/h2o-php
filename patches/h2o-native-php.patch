+}
+
+static void test_read_budget_and_small_read(void)
+{
+    char payload[65536];
+    memset(payload, 'x', sizeof(payload));
+    int fds[2];
+    h2o_buffer_t *input;
+    h2o_buffer_init(&input, &h2o_socket_buffer_prototype);
+    ok(socketpair(AF_UNIX, SOCK_STREAM, 0, fds) == 0);
+    ok(fcntl(fds[0], F_SETFL, O_NONBLOCK) == 0);
+    memset(&read_observer, 0, sizeof(read_observer));
+    read_observer.enabled = 1;
+    ok(write(fds[1], payload, 1) == 1);
+    ok(on_read_core(fds[0], &input, sizeof(payload)) == NULL);
+    ok(input->size == 1);
+    ok(read_observer.queries == 0);
+    h2o_buffer_consume(&input, input->size);
+
+    ok(write(fds[1], payload, sizeof(payload)) == sizeof(payload));
+    ok(on_read_core(fds[0], &input, 8193) == NULL);
+    ok(input->size == 8193);
+    int queued = -1;
+    ok(ioctl(fds[0], FIONREAD, &queued) == 0);
+    ok(queued == sizeof(payload) - 8193);
+    ok(on_read_core(fds[0], &input, 4097) == NULL);
+    ok(input->size == 8193 + 4097);
+    ok(memcmp(input->bytes, payload, input->size) == 0);
+    read_observer.enabled = 0;
+    h2o_buffer_dispose(&input);
+    close(fds[0]);
+    close(fds[1]);
+}
+
+struct read_later_arrival_state {
+    size_t bytes;
+    int closed;
+};
+
+static void read_later_arrival(h2o_socket_t *sock, const char *err)
+{
+    struct read_later_arrival_state *state = sock->data;
+    if (err != NULL) {
+        state->closed = err == h2o_socket_error_closed ? 1 : -1;
+        h2o_socket_read_stop(sock);
+        return;
+    }
+    state->bytes += sock->input->size;
+    h2o_buffer_consume(&sock->input, sock->input->size);
+}
+
+static void test_read_zero_hint_later_arrival_and_eof(void)
+{
+    int fds[2];
+    struct read_later_arrival_state state = {0};
+    h2o_buffer_t *input;
+    h2o_buffer_init(&input, &h2o_socket_buffer_prototype);
+    size_t initial_capacity = h2o_buffer_reserve(&input, 4096).len;
+    char *payload = h2o_mem_alloc(initial_capacity);
+    memset(payload, 'x', initial_capacity);
+    h2o_buffer_dispose(&input);
+    ok(socketpair(AF_UNIX, SOCK_STREAM, 0, fds) == 0);
+    ok(fcntl(fds[0], F_SETFL, O_NONBLOCK) == 0);
+    h2o_evloop_t *loop = h2o_evloop_create();
+    h2o_socket_t *sock = h2o_evloop_socket_create(loop, fds[0], 0);
+    sock->data = &state;
+    h2o_socket_read_start(sock, read_later_arrival);
+    memset(&read_observer, 0, sizeof(read_observer));
+    read_observer.enabled = 1;
+    ok(write(fds[1], payload, initial_capacity) == initial_capacity);
+    for (int i = 0; i != 100 && state.bytes == 0; ++i)
+        h2o_evloop_run(loop, 0);
+    ok(state.bytes == initial_capacity);
+    ok(read_observer.queries == 1);
+    ok(read_observer.growths == 0);
+    ok(write(fds[1], payload, 1) == 1);
+    for (int i = 0; i != 100 && state.bytes == initial_capacity; ++i)
+        h2o_evloop_run(loop, 0);
+    ok(state.bytes == initial_capacity + 1);
+    ok(shutdown(fds[1], SHUT_WR) == 0);
+    for (int i = 0; i != 100 && state.closed == 0; ++i)
+        h2o_evloop_run(loop, 0);
+    ok(state.closed == 1);
+    read_observer.enabled = 0;
+    h2o_socket_close(sock);
+    h2o_evloop_run(loop, 0);
+    h2o_evloop_destroy(loop);
+    close(fds[1]);
+    free(payload);
+}
+#endif
 
