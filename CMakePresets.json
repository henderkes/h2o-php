{
  "version": 3,
  "configurePresets": [
    { "name": "release", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "debug", "inherits": "release", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "targets": ["native-server"], "jobs": 8 },
    { "name": "debug", "configurePreset": "debug", "targets": ["native-server"], "jobs": 8 }
  ]
}
