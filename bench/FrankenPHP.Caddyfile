{
	admin off
	auto_https off
	frankenphp {
		num_threads 4
		max_threads 8
		php_ini opcache.enable 1
		php_ini opcache.enable_cli 1
		php_ini opcache.jit off
	}
}

http://127.0.0.1:18081 {
	root * {$BENCH_ROOT}
	php_server {
		worker {
			file {$BENCH_ROOT}/worker.php
			num 4
			match /worker /worker/*
		}
	}
}
