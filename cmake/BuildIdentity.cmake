# Build-time identity, deliberately independent of configure-time git state.
# No timestamp is included: identical inputs generate identical metadata.
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT_HEADER)
  message(FATAL_ERROR "BuildIdentity needs SOURCE_DIR and OUTPUT_HEADER")
endif()
find_package(Git REQUIRED QUIET)
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE runtime_revision
  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE runtime_git_result)
if(NOT runtime_git_result EQUAL 0)
  set(runtime_revision "archive")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}/upstream/h2o" OUTPUT_VARIABLE h2o_revision
  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE h2o_git_result)
if(NOT h2o_git_result EQUAL 0)
  message(FATAL_ERROR "H2O checkout is missing its pinned git revision")
endif()

file(GLOB_RECURSE native_inputs LIST_DIRECTORIES false
  "${SOURCE_DIR}/src/*" "${SOURCE_DIR}/include/*" "${SOURCE_DIR}/cmake/*"
  "${SOURCE_DIR}/patches/*" "${SOURCE_DIR}/assets/*")
list(APPEND native_inputs "${SOURCE_DIR}/CMakeLists.txt")
execute_process(COMMAND "${GIT_EXECUTABLE}" diff --name-only HEAD
  WORKING_DIRECTORY "${SOURCE_DIR}/upstream/h2o"
  OUTPUT_VARIABLE modified_h2o OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REPLACE "\n" ";" modified_h2o "${modified_h2o}")
foreach(path IN LISTS modified_h2o)
  if(EXISTS "${SOURCE_DIR}/upstream/h2o/${path}")
    list(APPEND native_inputs "${SOURCE_DIR}/upstream/h2o/${path}")
  else()
    string(APPEND removed_inputs "removed:upstream/h2o/${path}\n")
  endif()
endforeach()
list(SORT native_inputs)
set(content "h2o:${h2o_revision}\n${removed_inputs}")
foreach(input IN LISTS native_inputs)
  file(RELATIVE_PATH relative "${SOURCE_DIR}" "${input}")
  file(SHA256 "${input}" digest)
  string(APPEND content "${digest} ${relative}\n")
endforeach()
string(SHA256 source_digest "${content}")
execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=all --
  CMakeLists.txt src include cmake patches assets
  WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE dirty
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(dirty)
  string(APPEND runtime_revision "+dirty")
endif()
set(revision_description "${runtime_revision} (source SHA256 ${source_digest})")
set(header "/* Generated by cmake/BuildIdentity.cmake. */\n#define H2O_PHP_REVISION \"${revision_description}\"\n#define H2O_PHP_H2O_REVISION \"${h2o_revision}\"\n#define H2O_PHP_PHP_VERSION \"${PHP_VERSION}\"\n#define H2O_PHP_PHP_ABI ${PHP_ABI}\n")
get_filename_component(output_directory "${OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
function(write_if_changed path value)
  if(EXISTS "${path}")
    file(READ "${path}" old_value)
    if(old_value STREQUAL value)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${value}")
endfunction()
write_if_changed("${OUTPUT_HEADER}" "${header}")
write_if_changed("${output_directory}/h2o-php-build-identity.txt"
  "runtime_revision=${runtime_revision}\nsource_sha256=${source_digest}\nh2o_revision=${h2o_revision}\nphp_version=${PHP_VERSION}\nphp_abi=${PHP_ABI}\nbuild_type=${BUILD_TYPE}\nc_compiler=${C_COMPILER}\n")
